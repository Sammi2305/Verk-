# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL="postgresql://verk:CHANGE_ME@localhost:5432/verkfinn?schema=public"

# Public base URL used in e-mails, sitemap and canonical URLs.
APP_URL="http://localhost:3000"

# Mail driver: "outbox" captures e-mails in the database as TEST e-mails and
# delivers nothing. No real provider is wired up yet (see docs/OPERATIONS.md).
MAIL_DRIVER="outbox"
MAIL_FROM="Verkvangur <noreply@example.is>"

# Shows the captured test e-mails at /dev/postholf. Never enable in production.
ENABLE_DEV_OUTBOX="true"

# Where uploaded images are stored (local driver). Must not be inside /public.
UPLOAD_DIR="./storage/uploads"

# Used once by `npm run db:seed` to create the first administrator.
SEED_ADMIN_EMAIL="admin@example.is"
SEED_ADMIN_PASSWORD="change-this-long-password"
SEED_ADMIN_NAME="Kerfisstjóri"
